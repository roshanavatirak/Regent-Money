<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="Theme.Intro" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="android:windowBackground">@color/intro_bg</item>
    <item name="android:statusBarColor">@color/intro_bg</item>
    <item name="android:navigationBarColor">@color/intro_bg</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    <item name="android:windowSplashScreenBackground">@color/intro_bg</item>
    <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    <item name="android:windowSplashScreenAnimationDuration">0</item>
  </style>
</resources>
