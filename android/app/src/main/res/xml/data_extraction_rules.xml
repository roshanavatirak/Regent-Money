<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <cloud-backup>
    <!-- Strictly forbid Google Drive/Cloud backup of local databases, secrets, and financial stores -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="regent_native_prefs.xml" />
    <exclude domain="root" path="." />
  </cloud-backup>
  <device-transfer>
    <!-- Strictly forbid ADB or device-to-device migration of local databases and keys -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="regent_native_prefs.xml" />
    <exclude domain="root" path="." />
  </device-transfer>
</data-extraction-rules>

