PORT=3000
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
JWT_SECRET=super_secret_jwt_key_change_me_in_production
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SMTP_USER=roshanavatirak@gmail.com
SMTP_PASS=your-smtp-app-password
BACKEND_URL=http://localhost:3000

# Brevo (Sendinblue) Transactional Email (HTTPS Port 443 - Recommended for Render & Cloud)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=roshanawatirak@gmail.com
BREVO_SENDER_NAME="Regent Money"

# Brevo Account for Marketing & Announcements (isolates broadcast quota from login/OTP quota)
BREVO_BROADCAST_API_KEY=xkeysib-your_secondary_brevo_api_key_here
BREVO_BROADCAST_SENDER_EMAIL=roshanawatirak@gmail.com
BREVO_BROADCAST_SENDER_NAME="Regent Money"
REDIS_URL="rediss://default:gQAAAAAAAkIXAAIgcDFhMTQzMmI2MTgxNTM0ZTFlYjM0MGZmNWMzNDkzN2RhOA@known-caiman-147991.upstash.io:6379"

# Google OAuth 2.0 Credentials (Backend Only)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Supabase SSL CA Certificate (Optional locally, required for strict TLS in production)
SUPABASE_CA_CERT=

# Dedicated Audit Log HMAC Secret
AUDIT_HMAC_SECRET=your_dedicated_hmac_secret_here


# Cloudflare Turnstile (login + signup human check, web and mobile app)
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# Set to false to let app builds without the Turnstile widget log in during rollout
TURNSTILE_REQUIRE_NATIVE=true

# Secret master key that protects every user encryption key (32+ random characters).
# Generate once (e.g. `openssl rand -base64 48`), set it on the server, and keep a copy somewhere safe:
# if it is lost, encrypted amounts and merchants cannot be read again. Never change it.
# FIELD_MASTER_KEY=

# Per-user daily limits for AI chat questions and statement/screenshot scans
AI_DAILY_LIMIT=40
AI_DAILY_SCAN_LIMIT=20
