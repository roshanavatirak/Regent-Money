PORT=3000
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
JWT_SECRET=super_secret_jwt_key_change_me_in_production
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SMTP_USER=roshanavatirak@gmail.com
SMTP_PASS=your-smtp-app-password
BACKEND_URL=http://localhost:3000

# Brevo (Sendinblue) Transactional Email (HTTPS Port 443 - Recommended for Render & Cloud)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=roshanawatirak@gmail.com
BREVO_SENDER_NAME="Regent Money"

# Brevo Account for Marketing & Announcements (isolates broadcast quota from login/OTP quota)
BREVO_BROADCAST_API_KEY=xkeysib-your_secondary_brevo_api_key_here
BREVO_BROADCAST_SENDER_EMAIL=roshanawatirak@gmail.com
BREVO_BROADCAST_SENDER_NAME="Regent Money"

# Brevo Account for welcome / thank-you emails (dedicated quota; falls back to broadcast, then sign-in down to its reserve)
BREVO_WELCOME_API_KEY=xkeysib-your_welcome_brevo_api_key_here
BREVO_WELCOME_SENDER_EMAIL=you@example.com
BREVO_WELCOME_SENDER_NAME="Regent Money"
REDIS_URL="rediss://default:gQAAAAAAAkIXAAIgcDFhMTQzMmI2MTgxNTM0ZTFlYjM0MGZmNWMzNDkzN2RhOA@known-caiman-147991.upstash.io:6379"

# Google OAuth 2.0 Credentials (Backend Only)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Supabase SSL CA Certificate (Optional locally, required for strict TLS in production)
SUPABASE_CA_CERT=

# Dedicated Audit Log HMAC Secret
AUDIT_HMAC_SECRET=your_dedicated_hmac_secret_here


# Cloudflare Turnstile (login + signup human check, web and mobile app)
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# Set to false to let app builds without the Turnstile widget log in during rollout
TURNSTILE_REQUIRE_NATIVE=true

# Secret master key that protects every user encryption key (32+ random characters).
# Generate once (e.g. `openssl rand -base64 48`), set it on the server, and keep a copy somewhere safe:
# if it is lost, encrypted amounts and merchants cannot be read again. Never change it.
# FIELD_MASTER_KEY=

# Per-user daily limits for AI chat questions and statement/screenshot scans
AI_DAILY_LIMIT=40
AI_DAILY_SCAN_LIMIT=20

# Backup AI keys for statement / screenshot scans, tried in this order when the first ones fail:
# Gemini (GEMINI_API_KEY) -> Gemini (GEMINI_API_KEY_2) -> Groq (GROQ_API_KEY_2, or GROQ_API_KEY if not set)
GEMINI_API_KEY_2=
GROQ_API_KEY_2=
# Optional: Groq models for scans (defaults: openai/gpt-oss-120b for statements, qwen/qwen3.8-27b for images)
# GROQ_SCAN_TEXT_MODEL=
# GROQ_SCAN_VISION_MODEL=

# ---- Install attribution (invite and campaign links) ----
# Public HTTPS address that serves this backend; invite links are <this>/r/<code>.
# Falls back to BACKEND_URL when empty.
INVITE_LINK_BASE_URL=
# Google Play Integrity: proves an invite claim came from the real app, installed from Play,
# on a genuine device. Until both values are set, link installs are held as "unverified"
# and are not counted.
#   1. Google Cloud Console: enable "Play Integrity API" in a project.
#   2. Play Console > your app > Protected with Play > Play Integrity API > Link Cloud project.
#   3. Create a service account in that project and paste its JSON key here on one line.
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
# Optional: comma-separated app signing certificate digests (base64url SHA-256) to pin.
PLAY_INTEGRITY_CERT_SHA256=
# "enforce" (default) or "off". "off" is ignored when NODE_ENV=production.
ATTRIBUTION_INTEGRITY_MODE=enforce

# Voice entry (speech to text), tried in order: Sarvam -> Groq Whisper -> Gemini.
# Up to three Sarvam keys; a key that is not set is left out.
# GROQ_VOICE_API_KEY / GEMINI_VOICE_API_KEY fall back to GROQ_API_KEY / GEMINI_API_KEY when empty.
SARVAM_API_KEY=
SARVAM_API_KEY_2=
SARVAM_API_KEY_3=
GROQ_VOICE_API_KEY=
GEMINI_VOICE_API_KEY=
# Voice entries per user per day
AI_DAILY_VOICE_LIMIT=40

# Dedicated Upstash Redis for the email queue (welcome emails)
EMAIL_QUEUE_REDIS_REST_URL="https://your-queue-db.upstash.io"
EMAIL_QUEUE_REDIS_REST_TOKEN="your_queue_rest_token"
